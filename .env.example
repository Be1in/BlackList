# Freeze-event reconstruction — local endpoints and secrets
# 复制为 .env 后填写；.env 已被 .gitignore 忽略，不要提交。
# 采集脚本通过 python-dotenv 读取这些名字，新增变量时两边同步。

# --- 工单 02 起必需：Ethereum 归档节点 ---
# 支持历史状态查询的完整 HTTP 端点。
ETHEREUM_ARCHIVE_RPC_URL=
# provider 单独发放 key 时填写；URL 内已含 key 可留空。
ETHEREUM_RPC_API_KEY=
# 端点标签，写入 manifest 与缓存键；留空按 tenderly_mainnet_gateway 处理。
ETHEREUM_ARCHIVE_ENDPOINT_LABEL=

# --- 参照端点：交叉核对用，可选 ---
# 逗号分隔，留空按 https://eth.drpc.org,https://eth-mainnet.public.blastapi.io 处理。
ETHEREUM_REFERENCE_RPC_URLS=
# 填入即启用 Etherscan v2 参照端（只服务日志、收据、区块头）。
ETHERSCAN_API_KEY=
# 设 0 显式停用 Etherscan 参照端。
ETHEREUM_REFERENCE_USE_ETHERSCAN=

# --- 配速：可选，留空按 8 / 3 处理 ---
ETHEREUM_RPC_REQUESTS_PER_SECOND=
ETHEREUM_ETHERSCAN_REQUESTS_PER_SECOND=

# --- 工单 06：带日期的历史交易所标签，可选 ---
# 来源尚未确定；留空时标签层记 not_attempted，比率记 not_reportable。
EXCHANGE_LABELS_API_URL=
EXCHANGE_LABELS_API_KEY=

# --- 工单 06：OFAC SDN 历史快照，可选 ---
# 默认走公共下载；使用镜像或 API 时填写。
OFAC_SDN_BASE_URL=
